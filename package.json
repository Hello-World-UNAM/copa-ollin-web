{
  "name": "copa-ollin-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=11.0.0 <12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.2",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "dev:sandbox:mock": "node scripts/dev-sandbox-mock.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:contrato:sprint04": "vitest run src/lib/registro/sprint04-fixtures.test.ts",
    "test:watch": "vitest",
    "test:google-sandbox": "vitest run src/lib/google/real.integration.test.ts",
    "sandbox:vista": "RUN_GOOGLE_SANDBOX_VISTA=true vitest run src/lib/google/vista-operativa.integration.test.ts",
    "sandbox:recuperacion": "RUN_GOOGLE_SANDBOX_RECUPERACION=true vitest run src/lib/google/recuperacion.integration.test.ts",
    "sandbox:concurrencia": "RUN_GOOGLE_SANDBOX_CONCURRENCIA=true vitest run src/lib/google/concurrencia.integration.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.0",
    "@astrojs/react": "6.0.6",
    "@astrojs/vercel": "11.0.3",
    "@fontsource-variable/orbitron": "5.3.0",
    "@google-cloud/firestore": "^9.3.1",
    "@hookform/resolvers": "^5.9.1",
    "@lucide/astro": "^1.48.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.8",
    "googleapis": "182.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/google.picker": "^0.0.52",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "^18.0.3",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.1.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vercel": "59.23.2",
    "vitest": "5.0.0"
  }
}
