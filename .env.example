# Copia estas claves a .env local y conserva los valores fuera de Git.
ENABLE_SANDBOX_REGISTRATION=true
USE_MOCK_GOOGLE=true
ENABLE_REAL_GOOGLE_SANDBOX=false

# Configuración solo para pruebas reales autorizadas; nunca usar recursos de CROFI/producción.
GOOGLE_APPLICATION_CREDENTIALS=.private/sandbox-service-account.json
SANDBOX_GOOGLE_SPREADSHEET_ID=
SANDBOX_GOOGLE_SHEET_RANGE=Registros!A:R
SANDBOX_GOOGLE_DRIVE_FOLDER_ID=

# Solo habilitar después de aprobación documentada de P0-06.
SANDBOX_GOOGLE_FILE_TEST_AUTHORIZED=false
