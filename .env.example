# Copia estas claves a .env local y conserva los valores fuera de Git.
ENABLE_SANDBOX_REGISTRATION=true
USE_MOCK_GOOGLE=true
ENABLE_REAL_GOOGLE_SANDBOX=false
SANDBOX_REGISTRATION_TOKEN=

# OAuth de servidor solo para pruebas autorizadas y recursos del sandbox.
SANDBOX_GOOGLE_OAUTH_CLIENT_ID=
SANDBOX_GOOGLE_OAUTH_CLIENT_SECRET=
SANDBOX_GOOGLE_OAUTH_REFRESH_TOKEN=
SANDBOX_GOOGLE_PICKER_API_KEY=
SANDBOX_GOOGLE_PROJECT_NUMBER=
SANDBOX_GOOGLE_SPREADSHEET_ID=
SANDBOX_GOOGLE_SHEET_RANGE=Registros!A:R
SANDBOX_GOOGLE_DRIVE_FOLDER_ID=

# Firestore sólo reserva transactionId; credencial distinta de OAuth Drive/Sheets.
# Mantener estos valores como secretos de servidor; no se usan en el navegador.
SANDBOX_FIRESTORE_PROJECT_ID=
SANDBOX_FIRESTORE_CLIENT_EMAIL=
SANDBOX_FIRESTORE_PRIVATE_KEY=

# Solo habilitar con autorización explícita para la prueba remota del issue #10.
SANDBOX_GOOGLE_FILE_TEST_AUTHORIZED=false
