---
import { Image } from 'astro:assets';
import { BookOpen, FileDown } from '@lucide/astro';

import type { CategoryDefinition } from '../../data/categories';
import Card from '../ui/Card.astro';

interface Props {
  category: CategoryDefinition;
}

const { category } = Astro.props;
---

<Card muted class="category-card">
  <div class="category-card__media">
    <div
      class:list={[
        'category-card__media-frame',
        `category-card__media-frame--${category.slug}`,
      ]}
    >
      <Image
        src={category.image}
        alt={category.imageAlt}
        widths={[320, 480, 640]}
        sizes="(min-width: 768px) 30vw, 90vw"
        loading="lazy"
      />
    </div>
  </div>

  <div class="category-card__body">
    <h3>{category.workingName}</h3>

    {category.nameStatus === 'pending-confirmation' && (
      <p class="category-card__pending">
        Nombre público pendiente de confirmación por CROFI.
      </p>
    )}

    <div class="category-card__links">
      <a
        href={`/categorias/${category.slug}`}
        aria-label={`Ver reglamento de ${category.workingName}`}
      >
        <BookOpen size={20} aria-hidden="true" />
        Ver reglamento
      </a>
      <a
        href={category.regulationPdfUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Descargar reglamento de ${category.workingName} en formato PDF (abre en una nueva pestaña)`}
      >
        <FileDown size={20} aria-hidden="true" />
        Descargar PDF
      </a>
    </div>
  </div>
</Card>
