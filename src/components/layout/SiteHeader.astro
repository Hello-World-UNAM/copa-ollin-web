---
import { Image } from 'astro:assets';
import { Menu, X } from '@lucide/astro';

import crofiLogo from '../../../assets/brand/crofi-fondo-blanco.png';
import Container from '../ui/Container.astro';

const currentPath = Astro.url.pathname;
---

<header id="inicio" class="site-header">
  <Container class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Copa Ollin, inicio">
      <Image
        class="site-header__logo"
        src={crofiLogo}
        alt="CROFI"
        height={40}
        widths={[120, 180]}
        sizes="120px"
      />
      <span class="site-header__identity" aria-hidden="true">
        <span class="site-header__name">Copa Ollin</span>
        <span class="site-header__edition">Robótica · 2026</span>
      </span>
    </a>

    <button
      class="site-nav__toggle"
      type="button"
      aria-controls="site-nav"
      aria-expanded="false"
      aria-label="Abrir menú"
      hidden
    >
      <Menu class="site-nav__icon-open" size={24} aria-hidden="true" />
      <X class="site-nav__icon-close" size={24} aria-hidden="true" />
      <span class="visually-hidden">Menú</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Navegación principal">
      <ul>
        <li>
          <a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>
            Inicio
          </a>
        </li>
        <li>
          <a href="/#categorias">Categorías</a>
        </li>
        <li>
          <a
            href="/registro"
            class="site-nav__registration"
            aria-current={currentPath === '/registro' ? 'page' : undefined}
          >
            Registro
          </a>
        </li>
      </ul>
    </nav>
  </Container>
</header>

<script>
  const menuButton =
    document.querySelector<HTMLButtonElement>('.site-nav__toggle');
  const navigation = document.querySelector<HTMLElement>('#site-nav');

  if (menuButton && navigation) {
    const desktop = window.matchMedia('(min-width: 64rem)');
    menuButton.closest('header')?.setAttribute('data-nav-ready', '');
    menuButton.hidden = false;

    const setMenuState = (isOpen: boolean, restoreFocus = true) => {
      menuButton.setAttribute('aria-expanded', String(isOpen));
      menuButton.setAttribute(
        'aria-label',
        isOpen ? 'Cerrar menú' : 'Abrir menú',
      );
      navigation.hidden = !desktop.matches && !isOpen;

      if (isOpen) {
        navigation.querySelector<HTMLAnchorElement>('a')?.focus();
      } else if (restoreFocus) {
        menuButton.focus();
      }
    };

    const syncViewport = () => {
      const focusWillBeHidden =
        !desktop.matches && navigation.contains(document.activeElement);
      setMenuState(false, focusWillBeHidden);
    };
    syncViewport();
    desktop.addEventListener('change', syncViewport);

    menuButton.addEventListener('click', () => {
      setMenuState(menuButton.getAttribute('aria-expanded') !== 'true');
    });

    navigation.addEventListener('click', (event) => {
      if (
        !desktop.matches &&
        event.target instanceof Element &&
        event.target.closest('a')
      ) {
        setMenuState(false);
      }
    });

    const closeMenuOutside = (event: Event) => {
      if (
        menuButton.getAttribute('aria-expanded') === 'true' &&
        event.target instanceof Node &&
        !navigation.contains(event.target) &&
        !menuButton.contains(event.target)
      ) {
        // Al pulsar fuera, recupera el foco si aún estaba en el menú;
        // al tabular fuera, conserva el foco en el destino elegido.
        setMenuState(
          false,
          event.type === 'pointerdown' &&
            navigation.contains(document.activeElement),
        );
      }
    };

    document.addEventListener('pointerdown', closeMenuOutside);
    document.addEventListener('focusin', closeMenuOutside);

    document.addEventListener('keydown', (event) => {
      if (
        event.key === 'Escape' &&
        menuButton.getAttribute('aria-expanded') === 'true'
      ) {
        setMenuState(false);
      }
    });
  }
</script>
