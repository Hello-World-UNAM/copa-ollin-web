---
interface Props {
  href?: string;
  download?: string;
  variant?: 'primary' | 'secondary' | 'dark';
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
}

const {
  href,
  download,
  variant = 'primary',
  type = 'button',
  disabled = false,
  class: className,
} = Astro.props;
const classes = ['button', `button--${variant}`, className];
---

{href ? (
  <a class:list={classes} href={href} download={download}>
    <slot />
  </a>
) : (
  <button class:list={classes} type={type} disabled={disabled}>
    <slot />
  </button>
)}
