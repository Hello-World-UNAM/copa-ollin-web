---
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import CategoryCard from '../components/categories/CategoryCard.astro';
import Container from '../components/ui/Container.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories } from '../data/categories';
---

<BaseLayout
  title="Copa Ollin 2026 — Información del torneo"
  description="Información oficial en preparación del torneo Copa Ollin 2026."
>
  <Container>
    <div class="stack">
      <section aria-labelledby="titulo-inicio">
        <p class="eyebrow">Evento 2026</p>
        <h1 id="titulo-inicio">Copa Ollin</h1>
        <p>
          Del 5 al 7 de noviembre de 2026. La sede está por confirmar y se
          publicará cuando la Facultad emita su aprobación oficial.
        </p>
        <p>
          El sitio abrirá el 15 de octubre a las 8:00 a.m. y las inscripciones
          cerrarán el 30 de octubre a las 23:59, en horario de Ciudad de México.
        </p>
        <p>
          Copa Ollin es una competencia de robótica organizada por CROFI en
          colaboración con Club Hello World para impulsar el trabajo en equipo,
          la innovación y la aplicación práctica de la ingeniería.
        </p>
        <div class="cluster">
          <Button href="/registro">Ver estado del registro</Button>
          <Button href="#categorias" variant="secondary">
            Consultar rutas de categorías
          </Button>
        </div>
      </section>

      <section aria-labelledby="titulo-premiacion">
        <Card muted>
          <p class="eyebrow">Premiación</p>
          <h2 id="titulo-premiacion">Estado actual</h2>
          <p>
            La información de premiación continúa en estado
            <strong>Por confirmar</strong> hasta contar con aprobación oficial
            de CROFI.
          </p>
        </Card>
      </section>

      <section id="categorias" aria-labelledby="titulo-categorias">
        <p class="eyebrow">Rutas preparadas</p>
        <h2 id="titulo-categorias">Categorías</h2>
        <ul class="route-list">
          {categories.map((category) => (
            <li>
              <CategoryCard category={category} />
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="titulo-reglamentos-registro">
        <Card>
          <p class="eyebrow">Participación</p>
          <h2 id="titulo-reglamentos-registro">Reglamentos y registro</h2>
          <p>
            Consulta el reglamento de cada categoría antes de preparar tu
            participación. El formulario de registro todavía se encuentra en
            preparación.
          </p>
          <div class="cluster">
            <Button href="#categorias" variant="secondary">
              Consultar reglamentos
            </Button>
            <Button href="/registro">Ver estado del registro</Button>
          </div>
        </Card>
      </section>
    </div>
  </Container>
</BaseLayout>
