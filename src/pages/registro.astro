---
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Container from '../components/ui/Container.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import RegistroForm from '../components/registro/RegistroForm';

const sandboxHabilitado = import.meta.env.REGISTRO_SANDBOX_MODE === 'true';
---

<BaseLayout
  title={sandboxHabilitado ? 'Registro — Copa Ollin' : 'Registro — Copa Ollin'}
  description="Estado del registro para Copa Ollin."
>
  <Container>
    {sandboxHabilitado ? (
      <>
        <Card>
          <p class="eyebrow">Convocatoria</p>
          <h1>Registro </h1>
          <p>
            Inscríbete junto a tu equipo para participar en la Copa Ollin. Llena
            los requisitos del formulario y sube los documentos requeridos.
          </p>
        </Card>
        <RegistroForm client:load />
      </>
    ) : (
      <Card>
        <p class="eyebrow">Ruta preparada</p>
        <h1>Registro en preparación</h1>
        <p>
          El formulario todavía no está habilitado y esta página no recibe datos
          personales ni archivos. Su implementación depende de las decisiones
          pendientes de CROFI.
        </p>
        <Button href="/" variant="secondary">
          Volver al inicio
        </Button>
      </Card>
    )}
  </Container>
</BaseLayout>
